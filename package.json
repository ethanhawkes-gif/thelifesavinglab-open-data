{
  "name": "thelifesavinglab-open-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build:data": "node scripts/build-release.mjs && node scripts/release-to-sql.mjs",
    "test": "node --test tests/",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "check": "npm run build:data && git diff --exit-code -- src/data seeds dist && npm test && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
